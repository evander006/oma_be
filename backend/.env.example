# Copy to backend/.env and adjust values. Never commit real secrets.

ENVIRONMENT=development
DEBUG=true
DEV_MODE=true

DATABASE_URL=sqlite:///./data/oma_dom.db
CORS_ORIGINS=*

# mock | openrouter | nvidia | gemini
# Prefer openrouter (NVIDIA VL via OpenRouter) for free multimodal analysis.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODELS=qwen/qwen2.5-vl-3b-instruct:free,nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://oma-be-85l2.onrender.com
OPENROUTER_APP_NAME=OMA Dom

# Optional NVIDIA API Catalog / NIM (https://integrate.api.nvidia.com/v1)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl

# Optional Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3.8-flash

# Image generation / editing — SEPARATE from VL chat.
# none = honest unavailable (default; VL models do not edit rooms)
# mock = test-only (returns original photo bytes; NOT product-conditioned)
# nvidia-nim = reserved for a future confirmed image-edit endpoint
IMAGE_GEN_PROVIDER=none
IMAGE_GEN_MODEL=
IMAGE_GEN_MAX_PRODUCT_REFS=4
IMAGE_GEN_TIMEOUT_SECONDS=120

# Development loyalty (NOT official OMA rules)
LOYALTY_EARN_RATE_PER_BYN=1.0
LOYALTY_REDEEM_VALUE_PER_POINT=0.01
LOYALTY_ALLOW_NEGATIVE=false
LOYALTY_PROGRAM_LABEL=OMA Dom development loyalty (demo rules)

OMA_MAX_PRODUCTS=20
OMA_REQUEST_DELAY_SECONDS=0.8
OMA_ALLOW_INSECURE_SSL=true
MAX_UPLOAD_BYTES=8388608
MAX_ROOM_PHOTOS=5
AI_HISTORY_LIMIT=12
RATE_LIMIT_AI_PER_MINUTE=20
IMAGE_RETENTION_DAYS=30
