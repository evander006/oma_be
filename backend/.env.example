# Copy to backend/.env and adjust values. Never commit real secrets.

ENVIRONMENT=development
DEBUG=true
DEV_MODE=true

# SQLite by default; switch to PostgreSQL when ready:
# DATABASE_URL=postgresql+psycopg://oma:oma@localhost:5432/oma_dom
DATABASE_URL=sqlite:///./data/oma_dom.db

CORS_ORIGINS=*

# mock | gemini
AI_PROVIDER=mock
GEMINI_API_KEY=
# Free-tier multimodal Flash model (text + image). Override if unavailable for your key.
GEMINI_MODEL=gemini-3.8-flash

OMA_MAX_PRODUCTS=20
OMA_REQUEST_DELAY_SECONDS=0.8
OMA_ALLOW_INSECURE_SSL=true
MAX_UPLOAD_BYTES=8388608
MAX_ROOM_PHOTOS=5
AI_HISTORY_LIMIT=12
RATE_LIMIT_AI_PER_MINUTE=20
IMAGE_RETENTION_DAYS=30
