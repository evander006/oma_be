        <script data-skip-moving="true">
        (function () {
            var menu = document.querySelector('.banners-block_menu.js-main-menu');
            if (!menu) return;
            var html = null;
            var loading = null;
            var hoveredSubmenu = null;
            menu.addEventListener('pointerover', function (event) {
                var item = event.target && event.target.closest ? event.target.closest('.js-main-menu-item') : null;
                if (item) hoveredSubmenu = item.getAttribute('data-submenu');
            });
            menu.addEventListener('pointerleave', function () {
                hoveredSubmenu = null;
            });
            function fetchMenu() {
                if (html) return Promise.resolve(html);
                if (loading) return loading;
                loading = fetch('/local/include/catalog_menu.php', { credentials: 'same-origin' })
                    .then(function (response) { return response.text(); })
                    .then(function (text) {
                        html = text;
                        return text;
                    })
                    .catch(function (error) {
                        loading = null;
                        throw error;
                    });
                return loading;
            }
            function mount() {
                if (menu.querySelector('.js-main-submenu')) return;
                fetchMenu().then(function (text) {
                    if (menu.querySelector('.js-main-submenu')) return;
                    if (typeof initMainMenu !== 'function') {
                        setTimeout(mount, 40);
                        return;
                    }
                    menu.innerHTML = text;
                    initMainMenu();
                    if (typeof removeEmpty === 'function') removeEmpty(menu);
                    if (hoveredSubmenu && typeof mainMenuActivate === 'function') {
                        var activeItem = menu.querySelector('.js-main-menu-item[data-submenu="' + hoveredSubmenu + '"]');
                        if (activeItem) mainMenuActivate(activeItem);
                    }
                }).catch(function () {});
            }
            menu.addEventListener('pointerenter', mount, { once: true });
            function prefetch() {
                if (window.innerWidth < 768) return;
                if ('requestIdleCallback' in window) requestIdleCallback(function () { fetchMenu().catch(function () {}); }, { timeout: 5000 });
                else setTimeout(function () { fetchMenu().catch(function () {}); }, 2500);
            }
            if (document.readyState === 'complete') prefetch();
            else window.addEventListener('load', prefetch);
        })();
        </script>

